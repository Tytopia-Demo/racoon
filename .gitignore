/tmp/

## Specific to RubyMotion:
.dat*
.repl_history
build/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalisation:
/.bundle/
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Ruby version managers:
.ruby-version
.ruby-gemset

## Terraform:
# Local .terraform directories
**/.terraform/
# Terraform lock files (commit these for applications, ignore for libraries)
.terraform.lock.hcl
# Terraform state files
*.tfstate
*.tfstate.*
# Terraform plan files
*.tfplan
# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
# Terraform crash log
crash.log
crash.*.log
# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

## OS / editor artifacts:
.DS_Store
Thumbs.db

## Environment / secrets:
.env
.env.*
